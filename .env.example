# Agent Provider Configuration
# Set to 'gemini' or 'openrouter' or 'openai'
AGENT_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Optional OpenAI Alternative
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# JEV Risk Assessment Engine
# Set DECISION_ENGINE=jev to evaluate agent actions with JEV
DECISION_ENGINE=jev
OPENROUTER_API_KEY=your_openrouter_api_key_here
JEV_API_KEY=your_openrouter_api_key_here
AURA_JEV_MOCK_MODE=false
JEV_MODEL=typesafe/jev-1.13
JEV_TIMEOUT_SECONDS=10
JEV_ALLOW_THRESHOLD=0.1
JEV_BLOCK_THRESHOLD=0.9

# Database & Runtime Configuration
DATABASE_URL=sqlite:///./data/employees.db
MAX_AGENT_TURNS=8
MAX_TOOL_CALLS=20
EXPORT_LIMIT=10

# Pricing (Optional - empty means estimated cost unavailable)
PRICE_INPUT_PER_MILLION=
PRICE_OUTPUT_PER_MILLION=
